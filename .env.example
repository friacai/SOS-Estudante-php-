# SOS-Estudante - Configurações de Ambiente

APP_NAME="SOS-Estudante"
APP_ENV="development" # development ou production
APP_URL="http://localhost:8000"
APP_TIMEZONE="America/Sao_Paulo"

# Configurações do Banco de Dados
# O driver padrão é mysql. Se o MySQL não estiver ativo em seu ambiente,
# o sistema aceita 'mysql' ou 'sqlite'.
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sos_estudante
DB_USER=root
DB_PASS=

# Caminho para arquivo SQLite caso DB_DRIVER=sqlite (relativo à raiz do projeto)
DB_SQLITE_PATH=storage/database.sqlite

# Configurações de Sessão e Segurança
SESSION_LIFETIME=7200
CSRF_SECRET=sua_chave_secreta_super_segura_aqui
